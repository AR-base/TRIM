# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# trim token create --name you --role admin   -> paste the printed entry here (comma-separate several)
TRIM_API_TOKENS=

# trim key create
TRIM_ENCRYPTION_KEY=

# simulated (test organisation) or google
TRIM_CONNECTOR=simulated
TRIM_GOOGLE_ADMIN_EMAIL=
TRIM_GOOGLE_CUSTOMER_ID=my_customer

TRIM_OBSERVATION_DAYS=14
TRIM_BASELINE_DAYS=14
TRIM_ACTIVITY_RETENTION_DAYS=90
# Optional https:// webhook (Slack or Teams) for alerts and requests
TRIM_WEBHOOK_URL=
